{
  "schema_version": "1.0.0",
  "repository": {
    "id": "DonkeyJJLove/chunk-chunk",
    "url": "https://github.com/DonkeyJJLove/chunk-chunk",
    "owner": "DonkeyJJLove",
    "default_branch": "master",
    "vcs_ref": null
  },
  "cyber_lion": {
    "tile_id": "process-semantics.hmk9d",
    "roles": [
      "ProcessSemanticsEngine",
      "TransitionMicrocode",
      "TrajectoryDiagnostics"
    ],
    "layers": [
      "SEM"
    ],
    "disposition": [
      "KEEP",
      "REFINE",
      "GENERALIZE",
      "INTEGRATE"
    ]
  },
  "capabilities": [
    "process.state",
    "process.transition",
    "trajectory.score",
    "bridge.select",
    "threshold.request"
  ],
  "authority": {
    "maximum_level": "read",
    "required_gates": [
      "cyber-lion.mand"
    ]
  },
  "observability": {
    "logs": [
      "state.transition",
      "bridge.selection",
      "threshold.request"
    ],
    "metrics": [
      "trajectory.cost",
      "state.drift",
      "transition.count"
    ],
    "traces": [
      "state→bridge→threshold→proposal"
    ]
  },
  "security": {
    "trust_boundaries": [
      "semantic state != runtime authority",
      "bridge selection != permission",
      "threshold crossing may request gate but cannot apply gate",
      "process score is diagnostic rather than empirical ground truth"
    ]
  },
  "epistemic": {
    "status": "FORMALISED",
    "confidence": 0.8
  },
  "architecture_knowledge": {
    "schema_version": "1.0.0",
    "global_owner": "DonkeyJJLove/ai_platform",
    "semantic_exports": [
      "process_semantics",
      "hmk9d"
    ],
    "semantic_imports": [
      "architecture",
      "contracts",
      "currentness"
    ],
    "repository_dependencies": [
      "DonkeyJJLove/ai_platform"
    ],
    "architecture_artifacts": [
      {
        "path": "AGENTS.md",
        "class": "HUMAN_ARCHITECTURE_DOCUMENT",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "AI_NATIVE_ROADMAP.md",
        "class": "ROADMAP",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "PROCESS_GUARD.md",
        "class": "PROCESS_GUARD",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "doc/9D_process_design.md",
        "class": "HUMAN_ARCHITECTURE_DOCUMENT",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "hmk9d_protocol.yaml",
        "class": "SCHEMA",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "REPOSITORY_STANDARDIZATION_R1.json",
        "class": "MACHINE_READABLE_ARCHITECTURE",
        "currentness": "LOCAL_OWNER"
      }
    ],
    "discoverability": {
      "entrypoint": "AGENTS.md",
      "global_owner_route": "AGENTS.md -> cyber-lion.repository.json -> DonkeyJJLove/ai_platform:LION/architecture/v1_5/README.md",
      "max_reads_to_global_owner": 3
    },
    "invalidation_triggers": [
      "SOURCE_CHANGE",
      "CONTRACT_CHANGE",
      "CAPABILITY_CHANGE",
      "CURRENTNESS_CHANGE",
      "REPOSITORY_ROLE_CHANGE",
      "DEPENDENCY_CHANGE",
      "NAMING_STANDARD_CHANGE"
    ]
  }
}
